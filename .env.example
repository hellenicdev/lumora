PORT=3070
NODE_ENV=development
FRONTEND_URL=http://localhost:3060
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/db
# Required in every environment. The API refuses to boot if either secret is missing.
JWT_SECRET=change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_too
JWT_REFRESH_EXPIRES_IN=7d
TURNSTILE_SECRET=0x4AAAA...
RESEND_API_KEY=re_...
RESEND_FROM=noreply@lumora.dev
AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL_FAST=llama3-8b-8192
GITHUB_CLIENT_ID=Ov23...
GITHUB_CLIENT_SECRET=...
GITHUB_CALLBACK_URL=http://localhost:3070/api/github/callback
KOFI_PAGE_URL=https://ko-fi.com/yourpage
# Required. Ko-fi verification token. The API refuses to boot if this is unset.
KOFI_WEBHOOK_TOKEN=
# Comma-separated browser origins allowed to call the API (CORS and CSRF).
# Defaults to https://hellenicdev.eu. FRONTEND_URL's origin is included as well.
# The static site is served from https://hellenicdev.eu/lumora; the API host is separate.
# ALLOWED_ORIGINS=https://hellenicdev.eu
